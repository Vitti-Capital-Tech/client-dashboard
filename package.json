{
  "name": "client-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"lib/**/*.test.ts\" \"store/**/*.test.ts\"",
    "import:holdings": "node --env-file=.env.local scripts/import-holdings.mjs",
    "import:trades": "node --env-file=.env.local scripts/import-trades.mjs",
    "diff:pnl": "node scripts/diff-pnl-csv.mjs",
    "types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "suggest:aliases": "node --env-file=.env.local scripts/suggest-placement-aliases.mjs",
    "seed:auth": "node --env-file=.env.local scripts/seed-auth-users.mjs",
    "login:link": "node --env-file=.env.local scripts/login-link.mjs",
    "client:login": "node --env-file=.env.local scripts/link-client-login.mjs",
    "backfill:sectors": "node --env-file=.env.local scripts/backfill-sectors.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "exceljs": "^4.4.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
